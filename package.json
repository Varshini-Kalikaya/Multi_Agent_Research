{
  "name": "multi-agent-research-assistant",
  "version": "1.0.0",
  "description": "Multi-Agent Research Assistant Monorepo Root",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend install",
    "server": "npm --prefix backend start",
    "client": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test"
  },
  "engines": {
    "node": ">=18.0.0 <25.0.0"
  }
}
